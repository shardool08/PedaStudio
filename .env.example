# ── Admin panel (web dashboard at /admin/login) ──
ADMIN_SECRET=

# ── AI (required for lesson plans, scan, worksheets) ──
ANTHROPIC_API_KEY=

# ── API security (local dev only — App Hosting uses FIREBASE_CONFIG automatically) ──
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Firebase App Hosting (production API) ──
# 1. firebase login && firebase use pedastudio-d6b2a
# 2. firebase apphosting:secrets:set ANTHROPIC_API_KEY
# 3. Create backend in Console (App Hosting → Create) or: firebase apphosting:backends:create
# 4. Set NEXT_PUBLIC_FIREBASE_* in App Hosting → Environment (same as below)
# 5. npm run firebase:deploy-api
# 6. Set android/gradle.properties pedastudio.api.url.production to your hosted.app URL

# ── Firebase (phone OTP — recommended) ──
# Firebase Console → Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Supabase (optional cloud sync — skip if using Firebase only) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_DEV_OTP=false

# ── Optional: flashcard image generation scripts ──
OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
UNSPLASH_ACCESS_KEY=
