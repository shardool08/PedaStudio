# ── Admin panel (web dashboard at /admin/login) ──
ADMIN_SECRET=

# ── AI (required for lesson plans, scan, worksheets) ──
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-5-20250929 (auto-fallback if unavailable)
ANTHROPIC_MODEL=

# ── Supabase (database + Auth — replaces Firebase) ──
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never ship to Android
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Project Settings → Database → Connection string (URI)
# Needed to auto-create tables: node scripts/apply-supabase-schema.mjs
DATABASE_URL=
# Temporary on Railway while Firebase Admin is unavailable (Android still uses Firebase login)
ALLOW_PILOT_AUTH=true
# Local/dev OTP shortcuts only — must be false in production
ALLOW_DEV_OTP=false

# ── API host ──
# Deploy Next.js to Railway or a VPS (long AI timeouts). See docs/SUPABASE_MIGRATION.md
# Then set android/gradle.properties:
#   pedastudio.api.url.production=https://YOUR_API_HOST

# ── Legacy Firebase (remove after cutover) ──
# FIREBASE_SERVICE_ACCOUNT_JSON=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Razorpay (subscription payments — use test keys rzp_test_… for dev) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional support contacts
# PEDASTUDIO_SUPPORT_WHATSAPP=919876543210
# PEDASTUDIO_SUPPORT_EMAIL=support@pedastudio.in

# ── Optional: flashcard image generation scripts ──
OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
UNSPLASH_ACCESS_KEY=
