# Copy to local.properties (gitignored) for local API + Razorpay testing.
# Emulator: use 10.0.2.2 to reach the host machine's localhost:3000
# pedastudio.api.url=http://10.0.2.2:3000
#
# Physical device on same Wi‑Fi: use your PC's LAN IP, e.g.
# pedastudio.api.url=http://192.168.1.42:3000
#
# Leave unset to use production API (gradle.properties pedastudio.api.url.production).
